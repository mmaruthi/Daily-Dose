        "# Update the features set\n",
        "\n",
        "categorical_features = ['Model_Type','Vehicle Class','Transmission_Type','Fuel Type']\n",
        "numeric_features = ['Engine Size(L)','Cylinders','Fuel Consumption Comb (L/100 km)','Transmission_Gears']\n",
        "target = 'CO2 Emissions(g/km)'"
