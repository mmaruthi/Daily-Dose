    {
      "cell_type": "markdown",
      "source": [
        "This is an important field as it tells the wheel capacity. However we see there are 2053 unique fields. If we do One hot encoding on this , It will just explode. So let us categorize this with the values given in our data dictionary. I will create a new field \"Model_Type\" to categorize them first"
      ],
      "metadata": {
        "id": "JdPiAebqFnrd"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import re\n",
        "\n",
        "model_patterns = {\n",
        "    r\"(4WD|4X4)\": \"4WD/4X4\",\n",
        "    r\"AWD\": \"AWD\",\n",
        "    r\"FFV\": \"FFV\",\n",
        "    r\"SWB\": \"SWB\",\n",
        "    r\"LWB\": \"LWB\",\n",
        "    r\"EWB\": \"EWB\"\n",
        "}\n",
        "\n",
        "def map_model_type(model_name):\n",
        "    model_name = str(model_name).upper()\n",
        "    for pattern, label in model_patterns.items():\n",
        "        if re.search(pattern, model_name):\n",
        "            return label\n",
        "    return \"Other\"\n",
        "\n",
        "cars_df['Model_Type'] = cars_df['Model'].apply(map_model_type)"
      ],
      "metadata": {
        "id": "4seH6WesGY2a"
      },
      "execution_count": 34,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "cars_df['Model_Type'].unique()"
      ],
      "metadata": {
